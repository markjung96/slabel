# ── 상담 신청 알림 (필수) ───────────────────────────────────────────
# 이 둘이 없으면 상담 신청 API가 500을 반환한다.
# 예전처럼 조용히 성공 처리하면 문의가 통째로 유실되므로 반드시 설정할 것.

# https://resend.com 에서 발급
RESEND_API_KEY=

# 상담 신청 알림을 받을 원장님 이메일
NOTIFICATION_EMAIL=

# 발신자. Resend에서 도메인 인증을 마치기 전에는 비워두면
# onboarding@resend.dev 로 발송된다 (본인 계정 이메일로만 수신 가능).
# 도메인 인증 후: EMAIL_FROM="스라밸학원 <noreply@본인도메인>"
EMAIL_FROM=

# ── 관리자 로그인 (/admin) ─────────────────────────────────────────
ADMIN_PASSWORD=
# 토큰 서명용 임의 문자열. 생성: openssl rand -hex 32
ADMIN_SECRET=

# ── 업로드 이미지 저장소 ────────────────────────────────────────────
# Vercel은 파일시스템이 읽기 전용이라 이 토큰이 없으면
# 관리자 이미지 업로드가 프로덕션에서 동작하지 않는다.
# 발급: Vercel 대시보드 > Storage > Create Blob Store (연결 시 자동 주입)
BLOB_READ_WRITE_TOKEN=

# ── 상담 신청 암호화 키 ─────────────────────────────────────────────
# 상담 신청은 개인정보라 저장 전에 암호화한다.
# 한 번 정하면 절대 바꾸지 말 것 — 바꾸면 기존 신청을 못 읽는다.
# 생성: openssl rand -hex 32
LEADS_SECRET=
